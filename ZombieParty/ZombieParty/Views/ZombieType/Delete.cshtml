@model ZombieParty.Models.ZombieType

<h1>Supprimer un type de zombie </h1>

<h3>Êtes-vous certain de vouloir supprimer ce type?</h3>

<div>
    <p>
        <strong>Nom :</strong>
        @Model.TypeName

        <form asp-action="DeletePost" method="post">
        <input type="hidden" name="id" value="@Model.Id" />

        <button type="submit" class="btn btn-danger">
            Delete
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>
        </form>

    </p>
</div>