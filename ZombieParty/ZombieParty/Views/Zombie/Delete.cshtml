@model ZombieParty.Models.ZombieVM

<h1>Supprimer un zombie</h1>

<h3>Êtes-vous certain de vouloir supprimer ce zombie?</h3>

<div>
    <p>
        <strong>Nom :</strong>
        @Model.Zombie.Name

        <form asp-action="DeletePost" method="post">
        <input type="hidden" name="id" value="@Model.Zombie.Id" />

        <button type="submit" class="btn btn-danger">
            Delete
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>
        </form>

    </p>
</div>